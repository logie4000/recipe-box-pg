# Copy to .env (make env). Read by docker compose (deploy/), the Makefile,
# Rails (write-api, via dotenv in dev/test) and the Go read-api (dev).
# Production: generated from SSM Parameter Store by deploy/scripts/env-from-ssm.sh.
# Dev defaults only; every password here must be replaced in production.

COMPOSE_PROJECT_NAME=webapp
APP_NAME=app
APP_DOMAIN=example.com
APP_VERSION=dev

# --- PostgreSQL 16 (deploy/docker-compose.yml) ---
POSTGRES_VERSION=16.10
POSTGRES_SUPERUSER_PASSWORD=postgres-dev
POSTGRES_MAX_CONNECTIONS=60
# 127.0.0.1, not localhost: docker publishes ports on IPv4 only, and on Windows
# Ruby tries ::1 first and waits ~2 s for it to fail on every new connection.
DB_HOST=127.0.0.1
DB_PORT=5432
APP_DB_NAME=app
APP_TEST_DB_NAME=app_test
# One password per role (roles: deploy/postgres/init/01-roles.sh and the first Rails migration)
APP_OWNER_PASSWORD=owner-dev
APP_WRITER_PASSWORD=writer-dev
APP_READER_PASSWORD=reader-dev
APP_PLATFORM_PASSWORD=platform-dev
KEYCLOAK_DB_PASSWORD=keycloak-dev

# --- Keycloak ---
KEYCLOAK_VERSION=26.3
KEYCLOAK_PORT=8081
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-dev
# Google login (disabled in realm.json until you enable the IdP in Keycloak)
KC_GOOGLE_CLIENT_ID=
KC_GOOGLE_CLIENT_SECRET=

# --- OIDC, shared by both APIs ---
OIDC_ISSUER=http://localhost:8081/realms/app
OIDC_AUDIENCE=app-api
# Optional: where to fetch signing keys if the issuer URL isn't reachable from the API
# (containers: http://keycloak:8080/realms/app/protocol/openid-connect/certs).
# Locally, 127.0.0.1 avoids the same ~2 s IPv6 stall as DB_HOST on each key refresh;
# OIDC_ISSUER stays localhost because it must match the tokens' iss claim.
OIDC_JWKS_URL=http://127.0.0.1:8081/realms/app/protocol/openid-connect/certs
# /admin cookie login (Keycloak confidential client "rails-admin")
OIDC_ADMIN_CLIENT_ID=rails-admin
OIDC_ADMIN_CLIENT_SECRET=rails-admin-dev-secret
ADMIN_REDIRECT_URI=http://localhost:3000/admin/auth/keycloak/callback
ADMIN_POST_LOGOUT_URI=http://localhost:3000/admin/login
ADMIN_ROLE=admin

# --- APIs ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,capacitor://localhost,https://localhost
MIN_SUPPORTED_CLIENT_VERSION=0.0.0
READ_API_ADDR=:8080
READ_API_DB_MAX_CONNS=10
LOG_FORMAT=text
# Rate limits, per minute (0 turns one off). read-api: per client IP, split
# by whether the request carries a token. write-api: per signed-in user.
RATE_LIMIT_ANON_PER_MINUTE=120
RATE_LIMIT_ANON_BURST=60
RATE_LIMIT_USER_PER_MINUTE=600
RATE_LIMIT_USER_BURST=200
RATE_LIMIT_WRITES_PER_MINUTE=120
RATE_LIMIT_UPLOADS_PER_MINUTE=20
WRITE_API_PORT=3000
RAILS_MAX_THREADS=5
# Recipe photos: the write-api stores them, the read-api serves them, so both
# need the same directory. Unset in dev means <repo>/storage/images.
IMAGE_STORAGE=local
# IMAGE_STORAGE_DIR=
# Production only (bin/rails secret). Leave unset in development: an empty value breaks Rails.
# SECRET_KEY_BASE=
# auto: run pg_dump/psql inside the postgres container when they aren't installed locally
PG_TOOLS_VIA_DOCKER=auto

# --- Multi-tenancy (docs/multi-tenancy.md). Off by default. ---
TENANT_MODE=off
TENANT_SUBDOMAINS=off

# --- Production (deploy/docker-compose.prod.yml) ---
PGDATA_DIR=/srv/pgdata
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest
BACKUP_S3_URI=s3://my-backups/webapp
BACKUP_HOUR_UTC=3
AWS_REGION=us-east-1

# Production settings, uploaded to SSM Parameter Store (docs/ssm.md):
#
#   cp .env.production.example .env.production     (gitignored; fill it in)
#   deploy/scripts/env-to-ssm.sh .env.production
#
# deploy/scripts/deploy.sh rebuilds the server's .env from these on every
# deploy. Anything not listed falls back to the defaults in
# deploy/docker-compose*.yml. Replace every CHANGE_ME: env-to-ssm.sh refuses
# to upload them. Generate secrets with: openssl rand -hex 32
# Keys containing PASSWORD or SECRET are stored as SecureString.

COMPOSE_PROJECT_NAME=recipe-box
APP_NAME=recipe-box
APP_DOMAIN=example.com
# The site and the Keycloak login page. Default app.<APP_DOMAIN> and
# auth.<APP_DOMAIN>; set either to use another name (DNS, a TLS certificate
# and web/src/environments/environment.ts must match).
# APP_HOST=www.example.org
# AUTH_HOST=auth.example.org
# Serve the app under a path of APP_HOST instead of its root, e.g.
# https://www.example.org/recipe-box. Must match "baseHref" in web/angular.json
# (production) and APP_PATH when rendering nginx (deploy/nginx/render.sh).
# APP_PATH=/recipe-box
AWS_REGION=us-east-1

# --- Images and backups ---
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
BACKUP_S3_URI=s3://my-backups/recipe-box
BACKUP_HOUR_UTC=3
# Recipe photos (docs/recipes.md, Photos on S3). Production uses S3 by default.
IMAGE_S3_BUCKET=my-photos
IMAGE_S3_PREFIX=recipe-box/

# --- Database role passwords ---
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
APP_OWNER_PASSWORD=CHANGE_ME
APP_WRITER_PASSWORD=CHANGE_ME
APP_READER_PASSWORD=CHANGE_ME
APP_PLATFORM_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- Keycloak (auth.<APP_DOMAIN>) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Optional Google login; leave empty until you set it up.
KC_GOOGLE_CLIENT_ID=
KC_GOOGLE_CLIENT_SECRET=

# --- APIs ---
# Rails session/cookie secret: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME
# Shared by Keycloak's rails-admin client and the write-api's /admin login.
# Keycloak only reads it the first time it starts (realm import); to change
# it later, also change it in the Keycloak admin console.
OIDC_ADMIN_CLIENT_SECRET=CHANGE_ME
# The OIDC issuer and /admin redirect URLs come from APP_HOST and AUTH_HOST
# (deploy/docker-compose.prod.yml), so they aren't set here.
CORS_ALLOWED_ORIGINS=https://app.example.com
LOG_FORMAT=json

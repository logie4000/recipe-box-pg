{
  "realm": "app",
  "displayName": "App",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "organizationsEnabled": true,
  "roles": {
    "realm": [
      { "name": "reader", "description": "Can read app data" },
      {
        "name": "editor",
        "description": "Can create, change and delete app data",
        "composite": true,
        "composites": { "realm": ["reader"] }
      },
      {
        "name": "admin",
        "description": "Can open /admin",
        "composite": true,
        "composites": { "realm": ["editor"] }
      }
    ]
  },
  "clients": [
    {
      "clientId": "app-spa",
      "name": "Angular SPA",
      "description": "Public client, Authorization Code + PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "rootUrl": "",
      "redirectUris": ["http://localhost:4200/*", "https://app.${APP_DOMAIN}/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##https://app.${APP_DOMAIN}/*"
      },
      "protocolMappers": [
        {
          "name": "audience app-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "app-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "roles", "email"],
      "optionalClientScopes": ["offline_access", "organization"]
    },
    {
      "clientId": "app-api",
      "name": "App APIs (audience)",
      "description": "Represents the read-api and write-api as a token audience. No login flows.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "rails-admin",
      "name": "Rails /admin",
      "description": "Confidential client for the write-api admin cookie login",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/admin/auth/keycloak/callback",
        "https://app.${APP_DOMAIN}/admin/auth/keycloak/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/admin/*##https://app.${APP_DOMAIN}/admin/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles in id token and userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "roles", "email"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Reader",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["default-roles-app", "reader"]
    },
    {
      "username": "editor",
      "email": "editor@example.test",
      "firstName": "Eddie",
      "lastName": "Editor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "editor", "temporary": false }],
      "realmRoles": ["default-roles-app", "editor"]
    },
    {
      "username": "admin",
      "email": "admin@example.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["default-roles-app", "admin"]
    },
    {
      "username": "bob",
      "email": "bob@globex.test",
      "firstName": "Bob",
      "lastName": "Globex",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["default-roles-app", "editor"]
    },
    {
      "username": "carol",
      "email": "carol@example.test",
      "firstName": "Carol",
      "lastName": "Both",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "realmRoles": ["default-roles-app", "editor"]
    }
  ],
  "organizations": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Acme Corp",
      "alias": "acme",
      "enabled": true,
      "description": "Tenant demo (TENANT_MODE=on)",
      "domains": [{ "name": "acme.test", "verified": false }],
      "members": [{ "username": "alice" }, { "username": "carol" }]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Globex",
      "alias": "globex",
      "enabled": true,
      "description": "Tenant demo (TENANT_MODE=on)",
      "domains": [{ "name": "globex.test", "verified": false }],
      "members": [{ "username": "bob" }, { "username": "carol" }]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KC_GOOGLE_CLIENT_ID:unset}",
        "clientSecret": "${KC_GOOGLE_CLIENT_SECRET:unset}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    }
  ]
}

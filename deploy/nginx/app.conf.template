# Site config for Rob's existing nginx. Render with only our variables so
# nginx's own $vars survive:
#
#   APP_DOMAIN=example.com APP_NAME=myapp deploy/nginx/render.sh > /etc/nginx/sites-available/myapp.conf
#
# app.${APP_DOMAIN}   Angular build + the two APIs + /admin
# auth.${APP_DOMAIN}  Keycloak
# TLS certificates: certbot (paths below) or your own.

upstream ${APP_NAME}_read_api  { server 127.0.0.1:8080; keepalive 16; }
upstream ${APP_NAME}_write_api { server 127.0.0.1:3000; keepalive 16; }
upstream ${APP_NAME}_keycloak  { server 127.0.0.1:8081; keepalive 16; }

# One REST URL space, /api/v1/*, split by method: reads (GET/HEAD, and CORS
# preflights for them) go to the Go read-api, every write to the Rails
# write-api. So non-GET requests still never reach the read-api.
map "$request_method:$http_access_control_request_method" $${APP_NAME}_api_upstream {
    default                  ${APP_NAME}_write_api;
    "~^(GET|HEAD):"          ${APP_NAME}_read_api;
    "~^OPTIONS:(GET|HEAD)?$" ${APP_NAME}_read_api;
}

server {
    listen 80;
    server_name app.${APP_DOMAIN} auth.${APP_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name app.${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/app.${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.${APP_DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 10m;

    # Angular build output (web/dist/web/browser)
    root /srv/www/${APP_NAME};
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|woff2?|svg|png|jpg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # REST API: GET/HEAD -> Go read-api, POST/PUT/PATCH/DELETE -> Rails
    # write-api (see the map above).
    location /api/v1/ {
        proxy_pass http://$${APP_NAME}_api_upstream;
        include /etc/nginx/snippets/${APP_NAME}-proxy.conf;
    }

    # Rails /admin cookie-login hook (and any admin UI mounted later)
    location /admin {
        proxy_pass http://${APP_NAME}_write_api;
        include /etc/nginx/snippets/${APP_NAME}-proxy.conf;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name auth.${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/auth.${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.${APP_DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Consider restricting the admin console to your IP:
    # location /admin/ { allow 203.0.113.10; deny all; proxy_pass http://${APP_NAME}_keycloak; include /etc/nginx/snippets/${APP_NAME}-proxy.conf; }

    location / {
        proxy_pass http://${APP_NAME}_keycloak;
        include /etc/nginx/snippets/${APP_NAME}-proxy.conf;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}

# Site config for Rob's existing nginx. Render with only our variables so
# nginx's own $vars survive:
#
#   APP_DOMAIN=example.com APP_NAME=myapp deploy/nginx/render.sh > /etc/nginx/conf.d/myapp.conf
#
# https://${APP_HOST}${APP_PATH}/  Angular build + the two APIs + /admin
# https://${AUTH_HOST}/            Keycloak
# The app's locations are in locations.conf.template.
# TLS certificates: certbot (paths below) or your own.

upstream ${APP_NAME}_read_api  { server 127.0.0.1:8080; keepalive 16; }
upstream ${APP_NAME}_write_api { server 127.0.0.1:3000; keepalive 16; }
upstream ${APP_NAME}_keycloak  { server 127.0.0.1:8081; keepalive 16; }

# One REST URL space, /api/v1/*, split by method: reads (GET/HEAD, and CORS
# preflights for them) go to the Go read-api, every write to the Rails
# write-api. So non-GET requests still never reach the read-api.
map "$request_method:$http_access_control_request_method" $${APP_ID}_api_upstream {
    default                  ${APP_NAME}_write_api;
    "~^(GET|HEAD):"          ${APP_NAME}_read_api;
    "~^OPTIONS:(GET|HEAD)?$" ${APP_NAME}_read_api;
}

# Edge backstop per client IP, above the apps' own limits (read-api: per IP,
# split anonymous/signed-in; write-api: per user). Catches floods before they
# reach either app, plus anything sent straight at a /api path.
limit_req_zone $binary_remote_addr zone=${APP_NAME}_api:10m rate=20r/s;

# --- app server: left out with APP_SERVER=existing (render.sh) ---
server {
    listen 80;
    server_name ${APP_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_HOST};

    ssl_certificate     /etc/letsencrypt/live/${APP_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_HOST}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # The app: Angular build, the two APIs, /admin (locations.conf.template)
    include /etc/nginx/snippets/${APP_NAME}-locations.conf;
}
# --- end app server ---

server {
    listen 80;
    server_name ${AUTH_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${AUTH_HOST};

    ssl_certificate     /etc/letsencrypt/live/${AUTH_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AUTH_HOST}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Consider restricting the admin console to your IP:
    # location /admin/ { allow 203.0.113.10; deny all; proxy_pass http://${APP_NAME}_keycloak; include /etc/nginx/snippets/${APP_NAME}-proxy.conf; }

    location / {
        proxy_pass http://${APP_NAME}_keycloak;
        include /etc/nginx/snippets/${APP_NAME}-proxy.conf;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
